@echo off
chcp 65001 > nul
title منصة اقرأ - خادم تتبع القراءة اليومي

echo ========================================================
echo   📖 جاري تشغيل منصة اقرأ بأحدث تصميم ونظام دخول...
echo ========================================================

:: إنهاء أي خادم قديم يعمل في الخلفية
taskkill /F /IM node.exe > nul 2>&1

:: تشغيل السيرفر في الخلفية
start "IqraServer" /min node server.js

:: الانتظار ثانيتين
timeout /t 2 /nobreak > nul

:: فتح المتصفح على الموقع
start http://localhost:3000

echo ========================================================
echo   تم تشغيل وفتح منصة اقرأ بنجاح!
echo ========================================================
exit
